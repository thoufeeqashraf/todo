# Supabase. Use placeholders locally; do not commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# HMAC secret for the development operator cookie at /login.
# Generate a long random string. This placeholder is not a real secret.
# Customer API tokens do not use this value.
SESSION_SECRET=replace_with_a_long_random_string

# Transaction Junction, maps, CCTV, and email are stubs.
# The app does not read provider secrets and does not call those networks.

# Stripe company subscriptions (Starter, Growth, Scale in INR).
# Leave these blank locally. Checkout returns 503 until they are set.
# See docs/BILLING.md. Do not commit live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
